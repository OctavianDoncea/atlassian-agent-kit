POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=http://localhost:8000/auth/atlassian/callback
ATLASSIAN_SCOPES=read:jira-work write:jira-work read:jira-user read:confluence-content.all write:confluence-content read:confluence-space.summary read:space:confluence read:page:confluence write:page:confluence offline_access

ATLASSIAN_SITE_URL=https://your-domain.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# Fernet key for encrypting OAuth tokens at rest + signing OAuth state
TOKEN_ENCRYPTION_KEY=

GROQ_API_KEY=your_actual_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
JUDGE_LLM_MODEL=openai/gpt-oss-20b